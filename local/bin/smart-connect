#!/usr/bin/env python3
"""Smart Connect — panel del Samsung S20 FE que se despliega desde waybar.

    smart-connect            mostrar/ocultar el panel (botón 󰄜 de la barra)
    smart-connect --daemon   arrancar oculto (autostart), así abre al instante

Ver pantalla y control usan scrcpy; "celular como pantalla" usa wayvnc + una
app VNC en el celu (AVNC); archivos, notificaciones y "hacer sonar" usan KDE Connect.
"""
import os
import sys

_LS = "/usr/lib/libgtk4-layer-shell.so"
if _LS not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = _LS
    os.execv(sys.executable, [sys.executable] + sys.argv)

import random
import re
import shutil
import string
import subprocess
import threading
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

HOME = Path.home()
CONF = HOME / ".config/celular"
CACHE = HOME / ".cache/smart-connect"
THUMB = CACHE / "pantalla.png"
COLORS = HOME / ".config/waybar/colors.css"
NOMBRE_DEFAULT = "Galaxy S20 FE 5G"
TITULO_MIRROR = "S20 FE"
TITULO_CONTROL = "Control S20"
VNC_PORT = "5900"

CONF.mkdir(parents=True, exist_ok=True)
CACHE.mkdir(parents=True, exist_ok=True)

def sh(*cmd, timeout=6):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""

def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)

def corriendo(patron):
    return bool(sh("pgrep", "-f", patron))

def notify(titulo, cuerpo=""):
    spawn("notify-send", "-a", "Smart Connect", "-i", "phone", titulo, cuerpo)

def refresh_bar():
    subprocess.run(["pkill", "-RTMIN+9", "waybar"])

def leer(path, default=""):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default

def adb_serial():
    """Serial del celu: USB primero, después Wi-Fi; si no hay, intenta reconectar."""
    def listar():
        out = sh("adb", "devices")
        return [l.split()[0] for l in out.splitlines()[1:] if l.endswith("\tdevice")]

    devs = listar()
    if not devs:
        ip = leer(CONF / "ultima-ip")
        if ip:
            sh("adb", "connect", ip, timeout=3)
        for l in sh("adb", "mdns", "services", timeout=3).splitlines():
            if "_adb-tls-connect" in l:
                addr = l.split()[-1]
                if "connected" in sh("adb", "connect", addr, timeout=3):
                    (CONF / "ultima-ip").write_text(addr)
                    break
        devs = listar()
    usb = [d for d in devs if ":" not in d and not d.startswith("adb-")]
    return (usb or devs or [""])[0]

def adb(serial, *args, timeout=6):
    return sh("adb", "-s", serial, *args, timeout=timeout)

def kdc_id():
    return sh("kdeconnect-cli", "-a", "--id-only", timeout=3).split("\n")[0]

def kdc_call(dev, modulo, metodo, iface=None):
    iface = iface or f"org.kde.kdeconnect.device.{modulo}"
    return sh("gdbus", "call", "--session", "--dest", "org.kde.kdeconnect",
              "--object-path", f"/modules/kdeconnect/devices/{dev}/{modulo}",
              "--method", f"{iface}.{metodo}", timeout=15)

def kdc_prop(dev, modulo, prop):
    return sh("gdbus", "call", "--session", "--dest", "org.kde.kdeconnect",
              "--object-path", f"/modules/kdeconnect/devices/{dev}/{modulo}",
              "--method", "org.freedesktop.DBus.Properties.Get",
              f"org.kde.kdeconnect.device.{modulo}", prop, timeout=3)

def calidad_wifi(rssi):
    if rssi is None:
        return "—"
    return "Buena" if rssi > -60 else "Media" if rssi > -72 else "Débil"

def leer_estado():
    """Junta todo lo que se sabe del celu. Corre en un hilo aparte."""
    e = {"serial": "", "kdc": "", "nombre": NOMBRE_DEFAULT, "conexion": None,
         "bateria": None, "cargando": False, "wifi": "—", "senal": "—", "notifs": None,
         "pantalla_on": False}
    s = adb_serial()
    e["kdc"] = kdc_id()
    if s:
        e["serial"] = s
        e["conexion"] = "Wi-Fi" if (":" in s or s.startswith("adb-")) else "USB"
        nombre = adb(s, "shell", "settings", "get", "global", "device_name")
        if nombre and nombre != "null":
            e["nombre"] = nombre
        bat = adb(s, "shell", "dumpsys", "battery")
        m = re.search(r"^\s*level:\s*(\d+)", bat, re.M)
        e["bateria"] = int(m.group(1)) if m else None
        e["cargando"] = bool(re.search(r"(AC|USB|Wireless) powered: true", bat))
        w = adb(s, "shell", "cmd", "wifi", "status")
        m = re.search(r"RSSI: (-?\d+)", w)
        e["wifi"] = calidad_wifi(int(m.group(1))) if m else "Apagado"
        t = adb(s, "shell", "dumpsys", "telephony.registry", timeout=8)
        m = re.search(r"mSignalStrength=.*", t)
        niveles = [int(n) for n in re.findall(r"level=(\d)", m.group(0))] if m else []
        if niveles:
            e["senal"] = ["Sin señal", "Débil", "Media", "Buena", "Excelente"][min(max(niveles), 4)]
        elif "mServiceState" in t:
            e["senal"] = "Sin SIM"
        e["pantalla_on"] = "mWakefulness=Awake" in adb(s, "shell", "dumpsys", "power")
    if e["kdc"]:
        if not s:
            e["conexion"] = "KDE Connect"
            b = re.findall(r"\d+", kdc_prop(e["kdc"], "battery", "charge"))
            e["bateria"] = int(b[0]) if b else None
        n = kdc_call(e["kdc"], "notifications", "activeNotifications")
        e["notifs"] = len(re.findall(r"'[^']+'", n))
    if s and e["notifs"] is None:
        n = adb(s, "shell", "dumpsys", "notification", "--noredact", timeout=8)
        e["notifs"] = n.count("NotificationRecord(") or None
    return e

def actualizar_miniatura(serial):
    """Captura la pantalla del celu (solo si está prendida) para la tarjeta."""
    tmp = CACHE / "tmp.png"
    with open(tmp, "wb") as f:
        r = subprocess.run(["adb", "-s", serial, "exec-out", "screencap", "-p"],
                           stdout=f, stderr=subprocess.DEVNULL, timeout=10)
    if r.returncode == 0 and tmp.stat().st_size > 1000:
        sh("magick", str(tmp), "-resize", "62x138^", "-gravity", "north", "-extent", "62x138", str(THUMB))
        return True
    return False

def mirror_toggle(_e):
    spawn(str(HOME / ".local/bin/celular"))

def control_toggle(e):
    if corriendo(f"window-title={TITULO_CONTROL}"):
        sh("pkill", "-f", f"window-title={TITULO_CONTROL}")
        return "Control cruzado apagado"
    if not e["serial"]:
        return "Conectá el celu por USB o Wi-Fi"
    spawn("scrcpy", "-s", e["serial"], f"--window-title={TITULO_CONTROL}",
          "--no-video", "--no-audio", "--keyboard=uhid", "--mouse=uhid")
    return "Tu mouse y teclado controlan el celu · Alt suelta el mouse"

def modo_pantalla():
    return leer(CONF / "modo-pantalla", "duplicar")

def pantalla_toggle(e):
    if corriendo("wayvnc"):
        sh("pkill", "-x", "wayvnc")
        if e["serial"]:
            adb(e["serial"], "reverse", "--remove", f"tcp:{VNC_PORT}")
        sh("mmsg", "dispatch", "destroy_all_virtual_output")
        return "El celu dejó de ser pantalla"
    if not e["serial"]:
        return "Conectá el celu por USB o Wi-Fi"
    salida = "eDP-1"
    monitores = sh("wlr-randr")
    principal = re.findall(r"^(\S+) \"", monitores, re.M)
    if principal:
        salida = principal[0]
    if modo_pantalla() == "extender":
        antes = set(re.findall(r"^(HEADLESS-\d+)", monitores, re.M))
        sh("mmsg", "dispatch", "create_virtual_output")
        time.sleep(0.8)
        nuevos = set(re.findall(r"^(HEADLESS-\d+)", sh("wlr-randr"), re.M)) - antes
        if not nuevos:
            return "Mango no pudo crear la pantalla virtual"
        salida = nuevos.pop()
        ancho = re.search(r"(\d+)x\d+ px.*current", monitores)
        sh("wlr-randr", "--output", salida, "--custom-mode", leer(CONF / "resolucion", "1200x540"),
           "--pos", f"{ancho.group(1) if ancho else 1366},0")
    spawn("wayvnc", "-o", salida, "--max-fps=30", "127.0.0.1", VNC_PORT)
    adb(e["serial"], "reverse", f"tcp:{VNC_PORT}", f"tcp:{VNC_PORT}")
    time.sleep(0.5)
    r = adb(e["serial"], "shell", "am", "start", "-a", "android.intent.action.VIEW",
            "-d", f"vnc://127.0.0.1:{VNC_PORT}")
    if "Error" in r:
        return "Instalá AVNC en el celu (Play Store / F-Droid) y volvé a tocar"
    return "Pantalla " + ("extendida" if modo_pantalla() == "extender" else "duplicada") + " en el celu"

def desconectar(e):
    for p in (f"window-title={TITULO_MIRROR}", f"window-title={TITULO_CONTROL}"):
        sh("pkill", "-f", p)
    if corriendo("wayvnc"):
        pantalla_toggle(e)
    if e["serial"] and e["conexion"] == "Wi-Fi":
        sh("adb", "disconnect", e["serial"])
        (CONF / "ultima-ip").unlink(missing_ok=True)
        return "Desconectado del Wi-Fi"
    return "Cerré todo · el cable sigue enchufado" if e["serial"] else "No había nada conectado"

def archivos(e):
    if not e["kdc"]:
        return "Emparejá KDE Connect en el celu para ver los archivos"
    kdc_call(e["kdc"], "sftp", "mountAndWait")
    mp = re.findall(r"'([^']+)'", kdc_call(e["kdc"], "sftp", "mountPoint"))
    if not mp:
        return "No se pudo montar el celu"
    link = HOME / "Celular"
    if link.is_symlink() or not link.exists():
        link.unlink(missing_ok=True)
        link.symlink_to(mp[0])
    spawn("thunar", str(link))
    return "Archivos del celu en ~/Celular"

def hacer_sonar(e):
    if not e["kdc"]:
        return "Necesita KDE Connect emparejado"
    sh("kdeconnect-cli", "-d", e["kdc"], "--ring")
    return "Sonando…"

def captura(e):
    if not e["serial"]:
        return "Conectá el celu por USB o Wi-Fi"
    spawn(str(HOME / ".local/bin/celular"), "captura")
    return "Captura guardada y copiada"

