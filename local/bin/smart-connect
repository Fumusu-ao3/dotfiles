def ico(glifo, *clases):
    l = Gtk.Label(label=glifo)
    l.add_css_class("ico")
    for c in clases:
        l.add_css_class(c)
    return l

def chip(texto, boton=False):
    w = Gtk.Button(label=texto) if boton else Gtk.Label(label=texto)
    w.add_css_class("chip")
    w.set_halign(Gtk.Align.START)
    return w

class Panel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Smart Connect")
        self.add_css_class("smart")
        self.estado = None
        self.ocupado = threading.Lock()
        self.timer = None

        LayerShell.init_for_window(self)
        LayerShell.set_namespace(self, "smart-connect")
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self, LayerShell.Edge.RIGHT, True)
        LayerShell.set_margin(self, LayerShell.Edge.TOP, 50)
        LayerShell.set_margin(self, LayerShell.Edge.RIGHT, 10)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)

        teclas = Gtk.EventControllerKey()
        teclas.connect("key-pressed", lambda _c, k, *_: k == Gdk.KEY_Escape and self.ocultar())
        self.add_controller(teclas)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        panel.add_css_class("panel")
        panel.set_size_request(430, -1)
        self.set_child(panel)

        cab = Gtk.Box(spacing=10)
        cab.append(ico("󰄜"))
        t = Gtk.Label(label="Smart Connect", hexpand=True, xalign=0)
        t.add_css_class("titulo")
        cab.append(t)
        for glifo, tip, fn in (("󰂞", "Hacer sonar", hacer_sonar),
                               ("\U000f0100", "Captura del celu", captura),
                               ("󰐲", "Vincular por Wi-Fi con QR", None)):
            b = Gtk.Button(label=glifo, tooltip_text=tip)
            b.add_css_class("redondo")
            b.connect("clicked", (lambda *_: self.mostrar_qr()) if fn is None
                      else (lambda _b, f=fn: self.accion(f)))
            cab.append(b)
        panel.append(cab)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        panel.append(self.stack)
        self.stack.add_named(self.pagina_principal(), "principal")
        self.stack.add_named(self.pagina_qr(), "qr")

        self.pie = Gtk.Label(xalign=0, wrap=True)
        self.pie.add_css_class("pie")
        panel.append(self.pie)

    def pagina_principal(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

        tarjeta = Gtk.Box(spacing=14)
        tarjeta.add_css_class("tarjeta")
        marco = Gtk.Overlay()
        marco.add_css_class("mini")
        marco.set_overflow(Gtk.Overflow.HIDDEN)
        marco.set_size_request(62, 138)
        marco.set_valign(Gtk.Align.CENTER)
        self.mini = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        self.mini.set_size_request(62, 138)
        marco.set_child(self.mini)
        self.mini_vacia = ico("\U000f011c", "mini-vacia")
        marco.add_overlay(self.mini_vacia)
        tarjeta.append(marco)

        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.CENTER)
        self.l_nombre = Gtk.Label(label=NOMBRE_DEFAULT, xalign=0)
        self.l_nombre.add_css_class("nombre")
        self.l_estado = Gtk.Label(label="● Buscando…", xalign=0)
        self.l_estado.add_css_class("estado")
        self.chips = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                                 max_children_per_line=4, column_spacing=6, row_spacing=6)
        info.append(self.l_nombre)
        info.append(self.l_estado)
        info.append(self.chips)
        tarjeta.append(info)
        box.append(tarjeta)

        grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        self.t_mirror = self.tile("󰍹", "Ver pantalla", chip("Celu → esta PC"), mirror_toggle)
        self.t_control = self.tile("󰍽", "Control cruzado", chip("Mouse y teclado"), control_toggle)
        self.c_modo = chip("", boton=True)
        self.c_modo.connect("clicked", self.cambiar_modo)
        self.t_pantalla = self.tile("󰹑", "Celu como pantalla", self.c_modo, pantalla_toggle)
        self.c_desc = chip("—")
        self.t_desc = self.tile("󰌙", "Desconectar", self.c_desc, desconectar)
        self.t_archivos = self.tile("󰉋", "Archivos del celu", chip("~/Celular"), archivos)
        grid.attach(self.t_mirror, 0, 0, 1, 1)
        grid.attach(self.t_control, 1, 0, 1, 1)
        grid.attach(self.t_pantalla, 0, 1, 1, 1)
        grid.attach(self.t_desc, 1, 1, 1, 1)
        grid.attach(self.t_archivos, 0, 2, 2, 1)
        box.append(grid)
        self.actualizar_modo()
        return box

    def pagina_qr(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, halign=Gtk.Align.CENTER)
        marco = Gtk.Box(halign=Gtk.Align.CENTER)
        marco.add_css_class("qr")
        self.qr = Gtk.Picture(can_shrink=False)
        marco.append(self.qr)
        box.append(marco)
        txt = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=44, label=(
            "En el celu: Opciones de desarrollador → Depuración inalámbrica →\n"
            "Vincular dispositivo con código QR, y escaneá esto."))
        box.append(txt)
        volver = Gtk.Button(label="Volver")
        volver.connect("clicked", lambda *_: self.stack.set_visible_child_name("principal"))
        box.append(volver)
        return box

    def tile(self, glifo, titulo, chip_w, fn):
        t = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        t.add_css_class("tile")
        t.set_cursor_from_name("pointer")
        fila = Gtk.Box(spacing=8)
        fila.append(ico(glifo))
        l = Gtk.Label(label=titulo, xalign=0)
        l.add_css_class("tile-titulo")
        fila.append(l)
        t.append(fila)
        t.append(chip_w)
        click = Gtk.GestureClick()
        click.connect("released", lambda *_: self.accion(fn))
        t.add_controller(click)
        return t

    def accion(self, fn):
        e = self.estado or {"serial": "", "kdc": "", "conexion": None}
        self.pie.set_text("…")

        def run():
            msg = fn(e)
            time.sleep(0.6)
            GLib.idle_add(self.pie.set_text, msg or "")
            refresh_bar()
            self.refrescar(miniatura=False)
        threading.Thread(target=run, daemon=True).start()

    def cambiar_modo(self, *_):
        nuevo = "extender" if modo_pantalla() == "duplicar" else "duplicar"
        (CONF / "modo-pantalla").write_text(nuevo)
        self.actualizar_modo()

    def actualizar_modo(self):
        self.c_modo.set_label("󰍺 Extender" if modo_pantalla() == "extender" else "󰍹 Duplicar")

    def refrescar(self, miniatura=True):
        if not self.ocupado.acquire(blocking=False):
            return

        def run():
            try:
                e = leer_estado()
                if miniatura and e["serial"] and e["pantalla_on"]:
                    actualizar_miniatura(e["serial"])
                GLib.idle_add(self.pintar, e)
            finally:
                self.ocupado.release()
        threading.Thread(target=run, daemon=True).start()

    def pintar(self, e):
        self.estado = e
        self.l_nombre.set_text(e["nombre"])
        if e["conexion"]:
            self.l_estado.set_text(f"● Conectado por {e['conexion']}")
            self.l_estado.remove_css_class("off")
        else:
            self.l_estado.set_text("● Desconectado")
            self.l_estado.add_css_class("off")
        self.chips.remove_all()
        if e["bateria"] is not None:
            self.chips.append(chip(f"{'󰂄' if e['cargando'] else '󰁹'} {e['bateria']}%"))
        if e["serial"]:
            self.chips.append(chip(f"󰖩 {e['wifi']}"))
            self.chips.append(chip(f"󰣺 {e['senal']}"))
        if e["notifs"]:
            self.chips.append(chip(f"󰍡 {e['notifs']}"))
        if THUMB.exists():
            self.mini.set_filename(str(THUMB))
        self.mini_vacia.set_visible(not THUMB.exists())

        for tile, activo in ((self.t_mirror, corriendo(f"window-title={TITULO_MIRROR} ")),
                             (self.t_control, corriendo(f"window-title={TITULO_CONTROL}")),
                             (self.t_pantalla, corriendo("wayvnc"))):
            (tile.add_css_class if activo else tile.remove_css_class)("activo")
        self.c_desc.set_text(e["conexion"] or "—")

        if not e["conexion"]:
            self.pie.set_text("Enchufalo por USB, o tocá 󰐲 para vincular por Wi-Fi")
        elif not e["kdc"] and self.pie.get_text() in ("", "…"):
            self.pie.set_text("Tip: emparejá KDE Connect para archivos, notificaciones y hacer sonar")
        return False

    def mostrar_qr(self):
        nombre = "smartconnect-" + "".join(random.choices(string.ascii_lowercase, k=6))
        clave = "".join(random.choices(string.digits, k=8))
        png = CACHE / "qr.png"
        sh("qrencode", "-s", "6", "-m", "1", "-o", str(png), f"WIFI:T:ADB;S:{nombre};P:{clave};;")
        self.qr.set_filename(str(png))
        self.stack.set_visible_child_name("qr")
        self.pie.set_text("Esperando que escanees el QR…")

        def esperar():
            fin = time.time() + 120
            while time.time() < fin and self.stack.get_visible_child_name() == "qr":
                for l in sh("adb", "mdns", "services", timeout=4).splitlines():
                    if nombre in l and "_adb-tls-pairing" in l:
                        if "Successfully" not in sh("adb", "pair", l.split()[-1], clave, timeout=15):
                            GLib.idle_add(self.pie.set_text, "No se pudo vincular, probá de nuevo")
                            return
                        GLib.idle_add(self.pie.set_text, "¡Vinculado! Conectando…")
                        for _ in range(10):
                            time.sleep(2)
                            if adb_serial():
                                break
                        GLib.idle_add(self.stack.set_visible_child_name, "principal")
                        GLib.idle_add(self.pie.set_text, "Conectado por Wi-Fi")
                        refresh_bar()
                        self.refrescar()
                        return
                time.sleep(2)
            GLib.idle_add(self.pie.set_text, "Se venció el QR, tocá 󰐲 de nuevo")
        threading.Thread(target=esperar, daemon=True).start()

    def cargar_css(self):
        prov = Gtk.CssProvider()
        prov.load_from_string(leer(COLORS) + "\n" + CSS)
        if getattr(self, "_css", None):
            Gtk.StyleContext.remove_provider_for_display(Gdk.Display.get_default(), self._css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self._css = prov

    def mostrar(self):
        self.cargar_css()  # por si cambió el wallpaper
        self.stack.set_visible_child_name("principal")
        self.pie.set_text("")
        self.present()
        self.refrescar()
        if not self.timer:
            self.timer = GLib.timeout_add_seconds(6, lambda: (self.refrescar(False), True)[1])

    def ocultar(self):
        self.set_visible(False)
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        return True

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.moelover.SmartConnect",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.panel = None

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        if not self.panel:
            self.hold()
            self.panel = Panel(self)
            self.panel.cargar_css()
            if "--daemon" in args:
                return 0
        if "--daemon" in args:
            return 0
        if self.panel.get_visible():
            self.panel.ocultar()
        else:
            self.panel.mostrar()
        return 0

if __name__ == "__main__":
    if not shutil.which("scrcpy"):
        print("Falta scrcpy")
    sys.exit(App().run(sys.argv))
