#!/usr/bin/env bash
DIR="$HOME/Grabaciones"
PID="${XDG_RUNTIME_DIR:-/tmp}/grabar-pantalla.pid"
ARCH="${XDG_RUNTIME_DIR:-/tmp}/grabar-pantalla.archivo"

grabando() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

aviso() {
    qs -c sidebar ipc call osd mostrar "$1" no "$2" >/dev/null 2>&1 ||
        notify-send -a osd -u low -t 1500 -h string:x-canonical-private-synchronous:grabar "$1  $2"
}

case "$1" in
    toggle)
        if grabando; then
            kill -INT "$(cat "$PID")"
            while grabando; do sleep 0.1; done
            rm -f "$PID"
            f="$(cat "$ARCH")"
            notify-send -a "Grabación" -i video-x-generic "Grabación guardada" "$(basename "$f")"
        else
            if ! command -v wf-recorder >/dev/null; then
                notify-send -a "Grabación" "Falta wf-recorder" "Instalalo con: sudo pacman -S wf-recorder"
                exit 1
            fi
            mkdir -p "$DIR"
            f="$DIR/video-$(date +%Y-%m-%d_%H-%M-%S).mp4"
            mon="$(pactl get-default-sink).monitor"
            wf-recorder -y -f "$f" -c h264_vaapi -d /dev/dri/renderD128 \
                --audio="$mon" -C aac >/dev/null 2>&1 &
            echo $! > "$PID"
            echo "$f" > "$ARCH"
            aviso 󰑊 "Grabando pantalla"
        fi
        pkill -RTMIN+11 waybar ;;
    carpeta)
        mkdir -p "$DIR"
        xdg-open "$DIR" ;;
    *)
        if grabando; then
            s=$(( $(date +%s) - $(stat -c %Y "$PID") ))
            t=$(printf '%d:%02d' $((s / 60)) $((s % 60)))
            echo "{\"text\":\"󰑊 $t\",\"tooltip\":\"Grabando la pantalla con el sonido de la compu\\nClick: parar\",\"class\":\"grabando\"}"
        else
            echo '{"text":"󰕧","tooltip":"Grabar pantalla con el sonido de la compu (sin micrófono)\nClick: grabar · Click derecho: ver grabaciones","class":"quieto"}'
        fi ;;
esac
