#!/usr/bin/env python3
"""Celular — ventana completa para el Samsung S20 FE (estilo "Phone Link").

    celular-app        abrir la ventana (si ya está abierta, la trae al frente)

Usa el mismo motor que smart-connect (scrcpy, adb, KDE Connect, wayvnc):
las funciones se importan de ~/.local/bin/smart-connect.
"""
import importlib.machinery
import importlib.util
import random
import re
import string
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = Path.home()
sys.dont_write_bytecode = True  # no ensuciar ~/.local/bin con __pycache__

_loader = importlib.machinery.SourceFileLoader("smart_connect", str(HOME / ".local/bin/smart-connect"))
_spec = importlib.util.spec_from_loader("smart_connect", _loader)
sc = importlib.util.module_from_spec(_spec)
_loader.exec_module(sc)

from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

CONF = sc.CONF
SCREEN_OFF_F = CONF / "pantalla-apagada"
RESOLUCIONES = [("1200x540", "Liviana · 1200×540"), ("1800x810", "Media · 1800×810"),
                ("2400x1080", "Nativa del S20 FE · 2400×1080")]

