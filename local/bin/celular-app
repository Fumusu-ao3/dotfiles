    "com.spotify.music": "Spotify", "com.twitter.android": "X", "com.roblox.client": "Roblox",
    "org.telegram.messenger": "Telegram", "com.google.android.youtube": "YouTube",
    "com.google.android.apps.youtube.music": "YouTube Music", "com.netflix.mediaclient": "Netflix",
    "com.pinterest": "Pinterest", "com.reddit.frontpage": "Reddit", "com.tumblr": "Tumblr",
    "org.kde.kdeconnect_tp": "KDE Connect", "com.gaurav.avnc": "AVNC",
    "com.devsisters.ck": "Cookie Run: Kingdom", "com.mercadopago.wallet": "Mercado Pago",
    "com.mercadolibre": "Mercado Libre", "com.google.android.apps.maps": "Maps",
    "com.android.chrome": "Chrome", "com.google.android.gm": "Gmail",
}

