#!/usr/bin/env python3
"""Ajustes rápidos — panel de Wi-Fi, Bluetooth, sonido y brillo para waybar.

    ajustes-rapidos            mostrar/ocultar (click en los íconos de la barra)
    ajustes-rapidos wifi       abrir directo en la lista de redes
    ajustes-rapidos bt         abrir directo en Bluetooth
    ajustes-rapidos --daemon   arrancar oculto (autostart), así abre al instante
"""
import os
import sys

_LS = "/usr/lib/libgtk4-layer-shell.so"
if _LS not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = _LS
    os.execv(sys.executable, [sys.executable] + sys.argv)

import re
import subprocess
import time
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

HOME = Path.home()
ENV_C = dict(os.environ, LC_ALL="C", LANG="C")
COLORS = HOME / ".config/waybar/colors.css"

def sh(*cmd, timeout=6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=ENV_C).stdout.strip()
    except Exception:
        return ""

def bt_power(on):
    if on:
        sh("rfkill", "unblock", "bluetooth")
        time.sleep(0.5)
    return sh("bluetoothctl", "power", "on" if on else "off")

def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def en_hilo(fn, despues=None):
    """Corre fn en otro hilo y pasa el resultado a despues() en el hilo de la interfaz."""
    def run():
        r = fn()
        if despues:
            GLib.idle_add(lambda: (despues(r), False)[1])
    threading.Thread(target=run, daemon=True).start()

def volumen(dev="@DEFAULT_AUDIO_SINK@"):
    out = sh("wpctl", "get-volume", dev)
    m = re.search(r"([\d.]+)", out)
    return (float(m.group(1)) if m else 0.0), "MUTED" in out

def brillo():
    partes = sh("brightnessctl", "-m").split(",")
    return int(partes[3].rstrip("%")) if len(partes) > 3 else None

def wifi_estado():
    on = sh("nmcli", "radio", "wifi") == "enabled"
    actual = ""
    for l in sh("nmcli", "-t", "-f", "ACTIVE,SSID", "device", "wifi").splitlines():
        if l.startswith("yes:"):
            actual = l[4:].replace("\\:", ":")
    return on, actual

def wifi_redes():
    conocidas = {l.rsplit(":", 1)[0].replace("\\:", ":")
                 for l in sh("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show").splitlines()
                 if l.endswith("802-11-wireless")}
    redes = {}
    out = sh("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", timeout=12)
    for l in out.splitlines():
        campos = [c.replace("\\:", ":") for c in re.split(r"(?<!\\):", l)]
        if len(campos) < 4 or not campos[1]:
            continue
        uso, ssid, senal, seg = campos[:4]
        senal = int(senal or 0)
        if ssid in redes and redes[ssid]["senal"] >= senal and uso != "*":
            continue
        redes[ssid] = {"ssid": ssid, "senal": senal, "segura": bool(seg.strip()),
                       "activa": uso == "*", "conocida": ssid in conocidas}
    return sorted(redes.values(), key=lambda r: (not r["activa"], not r["conocida"], -r["senal"]))

def bt_on():
    return "Powered: yes" in sh("bluetoothctl", "show")

def bt_dispositivos():
    vinculados = {l.split(" ", 2)[1] for l in sh("bluetoothctl", "devices", "Paired").splitlines()
                  if l.startswith("Device")}
    devs = []
    for l in sh("bluetoothctl", "devices").splitlines():
        partes = l.split(" ", 2)
        if len(partes) < 3 or partes[0] != "Device":
            continue
        mac, nombre = partes[1], partes[2]
        if nombre.replace("-", ":") == mac:  # dispositivos sin nombre: ruido
            continue
        info = sh("bluetoothctl", "info", mac, timeout=3)
        bat = re.search(r"Battery Percentage: 0x[0-9a-f]+ \((\d+)\)", info)
        icono = re.search(r"Icon: (\S+)", info)
        devs.append({"mac": mac, "nombre": nombre, "vinculado": mac in vinculados,
                     "conectado": "Connected: yes" in info,
                     "bateria": int(bat.group(1)) if bat else None,
                     "icono": icono.group(1) if icono else ""})
    return sorted(devs, key=lambda d: (not d["conectado"], not d["vinculado"], d["nombre"].lower()))

def bt_resumen():
    if not bt_on():
        return False, ""
    con = [d["nombre"] for d in bt_dispositivos() if d["conectado"]]
    return True, ", ".join(con)

ICONOS_BT = {"audio-headset": "󰋋", "audio-headphones": "󰋋", "audio-card": "󰓃",
             "input-mouse": "󰍽", "input-keyboard": "󰌌", "input-gaming": "󰊴",
             "phone": "󰄜", "computer": "󰟀", "video-display": "󰍹"}

PERFILES = {"power-saver": ("󰌪", "Ahorro"), "balanced": ("󰾅", "Equilibrado"),
            "performance": ("󰓅", "Rendimiento")}

